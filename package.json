{
  "name": "starscape-ui-system-v3",
  "version": "3.0.0",
  "private": false,
  "description": "Starscape UI System v3 — pure CSS library + optional React layer",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm --filter starscape-v3-web-demo dev",
    "build": "pnpm --filter @starlove/ui-react build",
    "build:demo": "pnpm --filter starscape-v3-web-demo build",
    "release": "pnpm --filter @starlove/ui-react build && pnpm -r publish --no-git-checks",
    "docs:dev": "pnpm --filter starscape-v3-docs dev",
    "docs:build": "pnpm --filter starscape-v3-docs build",
    "docs:preview": "pnpm --filter starscape-v3-docs preview"
  },
  "engines": {
    "node": ">=18"
  }
}
