{
  "name": "starscape-ui-system-v3",
  "version": "3.2.0",
  "private": true,
  "description": "Starscape UI System v3 — pure CSS library + optional React layer",
  "packageManager": "pnpm@11.1.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @starlove/ui-web-demo dev",
    "version:packages": "node scripts/version-packages.mjs",
    "test": "node --test packages/css/test/*.test.mjs test/*.test.mjs",
    "build": "pnpm --filter @starlove/ui-react build",
    "build:demo": "pnpm --filter @starlove/ui-web-demo build",
    "release": "pnpm --filter @starlove/ui-react build && pnpm --filter ./packages/css publish --no-git-checks && pnpm --filter ./packages/react publish --no-git-checks",
    "docs:dev": "pnpm --filter @starlove/ui-docs dev",
    "docs:build": "pnpm --filter @starlove/ui-docs build",
    "docs:preview": "pnpm --filter @starlove/ui-docs preview"
  },
  "engines": {
    "node": ">=18"
  }
}
