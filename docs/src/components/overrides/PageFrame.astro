---
/**
 * Starlight `PageFrame` override — replaces the stock header + fixed-sidebar
 * chrome with the `@starlove/ui` `sidebar` page template
 * (`packages/css/src/templates/sidebar.css`). The rail carries a brand header,
 * Starlight's Pagefind `<Search>`, the generated nav (`slot="sidebar"`), a
 * footer with the theme select, and a collapse toggle. The default slot
 * (Starlight's `TwoColumnContent` → markdown + right-hand TOC) fills
 * `.page-sidebar-main`. The stock `slot="header"` is intentionally dropped: the
 * template's own `@media (max-width: 768px)` rule folds the rail into a
 * horizontal top bar on small screens.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const base = import.meta.env.BASE_URL;
const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page-sidebar-app">
  <script is:inline>
    // No-flash: apply the persisted collapsed state before paint.
    (function () {
      try {
        if (localStorage.getItem('docs.sidebar') === '1') {
          document.currentScript.parentElement.setAttribute('data-collapsed', '');
        }
      } catch (e) {}
    })();
  </script>

  {
    hasSidebar && (
      <aside class="page-sidebar" aria-label="Site">
        <a class="page-sidebar-header" href={base} aria-label="Starscape UI v3 home">
          <span class="page-sidebar-logo page-sidebar-logo--img" aria-hidden="true">
            <img src={`${base}Starscape-Star.png`} alt="" width="34" height="34" />
          </span>
          <span class="page-sidebar-titles">
            <span class="page-sidebar-title">Starscape UI v3</span>
          </span>
        </a>

        <div class="page-sidebar-search">
          <Search />
        </div>

        <slot name="sidebar" />

        <div class="page-sidebar-footer">
          <div class="page-sidebar-footer-text">
            <span class="page-sidebar-footer-name">@starlove/ui</span>
            <span class="page-sidebar-footer-meta">docs · v3.2</span>
          </div>
          <ThemeSelect />
        </div>

        <div class="page-sidebar-toggle-wrap">
          <button
            type="button"
            class="page-sidebar-toggle"
            aria-pressed="false"
            aria-label="Collapse sidebar"
          >
            <span class="page-sidebar-toggle-icon" aria-hidden="true">«</span>
            <span class="page-sidebar-toggle-label">collapse</span>
          </button>
        </div>
      </aside>
    )
  }

  <main class="page-sidebar-main">
    <slot />
  </main>
</div>

<script>
  // Rail interactions for the sidebar template. Plain DOM — no framework.
  const STORAGE_KEY = 'docs.sidebar';

  function syncToggle(app: Element, btn: HTMLButtonElement) {
    const collapsed = app.hasAttribute('data-collapsed');
    btn.setAttribute('aria-pressed', String(collapsed));
    btn.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
    const label = btn.querySelector('.page-sidebar-toggle-label');
    if (label) label.textContent = collapsed ? 'expand' : 'collapse';
  }

  // Collapse toggle — persisted, mirrors the React template's `storageKey`.
  document.querySelectorAll<HTMLButtonElement>('.page-sidebar-toggle').forEach((btn) => {
    const app = btn.closest('.page-sidebar-app');
    if (!app) return;
    syncToggle(app, btn);
    btn.addEventListener('click', () => {
      const collapsed = app.toggleAttribute('data-collapsed');
      try {
        localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
      } catch (e) {}
      syncToggle(app, btn);
    });
  });

  // Nested nav-group expand/collapse.
  document.querySelectorAll<HTMLButtonElement>('.page-sidebar-nav-parent').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.page-sidebar-nav-group');
      if (!group) return;
      const expanded = group.toggleAttribute('data-expanded');
      btn.setAttribute('aria-expanded', String(expanded));
    });
  });
</script>
