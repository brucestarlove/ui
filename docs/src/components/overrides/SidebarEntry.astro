---
/**
 * Recursive node renderer for the Starscape sidebar rail.
 *
 * Maps Starlight's `SidebarEntry` tree onto the `@starlove/ui` `sidebar`
 * template markup (see `packages/css/src/templates/sidebar.css`):
 *   - depth 0 group  → `.page-sidebar-section` (uppercase label, no chevron)
 *   - nested group   → `.page-sidebar-nav-group` (collapsible, chevron)
 *   - link           → `.page-sidebar-nav-item` (`<a>`, `data-active` = isCurrent)
 *
 * Leading icons are the label's initial so the collapsed (72px) rail stays
 * legible; `title` drives the native tooltip in that state.
 */
import type { SidebarEntry } from '@astrojs/starlight/route-data';
import Self from './SidebarEntry.astro';

interface Props {
  entry: SidebarEntry;
  depth: number;
}

const { entry, depth } = Astro.props;

/** Does this subtree contain the current page? Used to auto-expand groups. */
function containsCurrent(node: SidebarEntry): boolean {
  return node.type === 'link' ? node.isCurrent : node.entries.some(containsCurrent);
}

/** First alphanumeric char of a label, for the collapsed-rail monogram. */
function initial(label: string): string {
  const m = label.match(/[a-z0-9]/i);
  return (m ? m[0] : label.charAt(0) || '•').toUpperCase();
}

const isLink = entry.type === 'link';
const expanded = !isLink && (containsCurrent(entry) || !entry.collapsed);
---

{
  isLink ? (
    <a
      class="page-sidebar-nav-item"
      href={entry.href}
      title={entry.label}
      data-active={entry.isCurrent ? '' : undefined}
      aria-current={entry.isCurrent ? 'page' : undefined}
      {...entry.attrs}
    >
      <span class="page-sidebar-nav-icon" aria-hidden="true">{initial(entry.label)}</span>
      <span class="page-sidebar-nav-label">{entry.label}</span>
      {entry.badge && <span class="page-sidebar-nav-badge">{entry.badge.text}</span>}
    </a>
  ) : depth === 0 ? (
    <div class="page-sidebar-section">
      <div class="page-sidebar-section-label">{entry.label}</div>
      {entry.entries.map((child) => (
        <Self entry={child} depth={depth + 1} />
      ))}
    </div>
  ) : (
    <div class="page-sidebar-nav-group" data-expanded={expanded ? '' : undefined}>
      <button
        type="button"
        class="page-sidebar-nav-item page-sidebar-nav-parent"
        aria-expanded={expanded}
        title={entry.label}
      >
        <span class="page-sidebar-nav-icon" aria-hidden="true">{initial(entry.label)}</span>
        <span class="page-sidebar-nav-label">{entry.label}</span>
        {entry.badge && <span class="page-sidebar-nav-badge">{entry.badge.text}</span>}
        <span class="page-sidebar-nav-chevron" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </span>
      </button>
      <div class="page-sidebar-nav-children">
        <div class="page-sidebar-nav-children-inner">
          {entry.entries.map((child) => (
            <Self entry={child} depth={depth + 1} />
          ))}
        </div>
      </div>
    </div>
  )
}
