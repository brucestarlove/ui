---
/**
 * Starlight `Sidebar` override — emits the `@starlove/ui` sidebar-template nav
 * (`.page-sidebar-nav`) from Starlight's route sidebar data instead of the
 * stock `SidebarSublist`. Rendered into `PageFrame`'s `slot="sidebar"`.
 */
import SidebarEntry from './SidebarEntry.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<nav class="page-sidebar-nav" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
  {sidebar.map((entry) => <SidebarEntry entry={entry} depth={0} />)}
</nav>
